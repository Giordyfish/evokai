{
  "name": "@evokai/evokai-ui",
  "version": "0.1.1",
  "description": "Embeddable interface for Evokai agents: a chat panel with its launcher and voice mode inside it, and a full-screen voice stage, as Web Components with React wrappers.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Giordyfish/evokai.git",
    "directory": "clients/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup && node scripts/size.mjs && node scripts/copy-legal.mjs",
    "size": "node scripts/size.mjs",
    "demo": "vite --config demo/vite.config.ts",
    "smoke": "node e2e/smoke.mjs"
  },
  "peerDependencies": {
    "@evokai/evokai-client": "0.1.1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@evokai/evokai-client": "file:../typescript",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.1",
    "preact": "^10.29.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false
}
